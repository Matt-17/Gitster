<Window x:Class="Gitster.Views.CheckoutRemoteBranchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create local branch"
        Width="440"
        SizeToContent="Height"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BackgroundPrimary}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="PromptLabel"
                   FontSize="12"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"/>

        <TextBox Grid.Row="2"
                 x:Name="NameBox"
                 FontSize="13"
                 Background="{DynamicResource BackgroundSecondary}"
                 Foreground="{DynamicResource TextPrimary}"
                 BorderBrush="{DynamicResource BorderTertiary}"
                 TextChanged="NameBox_TextChanged"/>

        <TextBlock Grid.Row="3"
                   x:Name="ErrorLabel"
                   Margin="0,4,0,0"
                   FontSize="12"
                   Foreground="{DynamicResource AccentDanger}"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>

        <CheckBox Grid.Row="5"
                  x:Name="CheckoutCheck"
                  IsChecked="True"
                  FontSize="12"
                  Foreground="{DynamicResource TextPrimary}"
                  Content="Check out the new branch"/>

        <CheckBox Grid.Row="7"
                  x:Name="UpstreamCheck"
                  IsChecked="True"
                  FontSize="12"
                  Foreground="{DynamicResource TextPrimary}"/>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="_Cancel"
                    Style="{DynamicResource DialogButton}"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="OkButton"
                    Content="_Create"
                    Style="{DynamicResource DialogPrimaryButton}"
                    IsDefault="True"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
